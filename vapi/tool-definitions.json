[
  {
    "type": "function",
    "function": {
      "name": "find_patient_by_phone",
      "description": "Look for existing, non-deleted patient records after the caller supplies a valid U.S. phone number.",
      "parameters": {
        "type": "object",
        "properties": {"phone_number": {"type": "string", "description": "A structurally valid U.S. phone number."}},
        "required": ["phone_number"],
        "additionalProperties": false
      }
    },
    "server": {"url": "{{APP_BASE_URL}}/voice/tools/vapi", "credentialId": "{{VAPI_CREDENTIAL_ID}}"}
  },
  {
    "type": "function",
    "function": {
      "name": "create_patient",
      "description": "Save a new patient only after a complete read-back and explicit caller authorization.",
      "parameters": {
        "type": "object",
        "properties": {
          "first_name": {"type": "string"},
          "last_name": {"type": "string"},
          "date_of_birth": {"type": "string", "description": "YYYY-MM-DD"},
          "sex": {"type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"]},
          "phone_number": {"type": "string"},
          "email": {"type": "string"},
          "address_line_1": {"type": "string"},
          "address_line_2": {"type": "string"},
          "city": {"type": "string"},
          "state": {"type": "string"},
          "zip_code": {"type": "string"},
          "insurance_provider": {"type": "string"},
          "insurance_member_id": {"type": "string"},
          "preferred_language": {"type": "string"},
          "emergency_contact_name": {"type": "string"},
          "emergency_contact_phone": {"type": "string"}
        },
        "required": ["first_name", "last_name", "date_of_birth", "sex", "phone_number", "address_line_1", "city", "state", "zip_code"],
        "additionalProperties": false
      }
    },
    "server": {"url": "{{APP_BASE_URL}}/voice/tools/vapi", "credentialId": "{{VAPI_CREDENTIAL_ID}}"}
  },
  {
    "type": "function",
    "function": {
      "name": "update_patient",
      "description": "Update an existing patient only after the caller identifies the record and explicitly confirms the changes.",
      "parameters": {
        "type": "object",
        "properties": {
          "patient_id": {"type": "string", "format": "uuid"},
          "changes": {"type": "object", "additionalProperties": true}
        },
        "required": ["patient_id", "changes"],
        "additionalProperties": false
      }
    },
    "server": {"url": "{{APP_BASE_URL}}/voice/tools/vapi", "credentialId": "{{VAPI_CREDENTIAL_ID}}"}
  }
]
